{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.config/design-engineering/hooks/design-check.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
